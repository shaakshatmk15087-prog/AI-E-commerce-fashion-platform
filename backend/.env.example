FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# MySQL: mysql+pymysql://user:password@localhost:3306/ai_fashion
# Leave empty to use a local SQLite file for quick development.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=60
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook
# Must be false in production. Enables the dev-only mock "pay" endpoint.
MOCK_PAYMENTS_ENABLED=true
SHIPPING_FLAT_MINOR=9900
FREE_SHIPPING_THRESHOLD_MINOR=99900
TAX_RATE_BPS=0
PENDING_ORDER_MINUTES=30
# AI stylist. Without a key the assistant uses its rule-based fallback.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Server-side refusal fallback model (empty to disable)
AI_FALLBACK_MODEL=claude-opus-4-8
AI_DAILY_MESSAGE_LIMIT=50
SCHEDULER_ENABLED=false
SCHEDULER_MINUTES=5
