# Copy to `.env` (never commit it). Generate each secret separately, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Public https URL users open (also the only allowed CORS origin and the base of emailed links)
PUBLIC_URL=https://shop.example.com
WEB_PORT=8080

SECRET_KEY=
JWT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=aifp
MYSQL_USER=aifp
MYSQL_PASSWORD=

# Payments. The mock provider is refused in production. Implement/verify a real gateway first (see docs/DEPLOYMENT.md).
PAYMENT_PROVIDER=razorpay
MOCK_PAYMENTS_ENABLED=false
# STAGING ONLY: lets the app boot with the mock provider. Never set in production.
ALLOW_INSECURE_MOCK_PAYMENTS=false

# AI stylist (leave the key empty to run in rule-based fallback mode)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_MESSAGE_LIMIT=50

# Optional monitoring / retention
SENTRY_DSN=
LOG_LEVEL=INFO
CHAT_RETENTION_DAYS=365
SCHEDULER_SECONDS=300
